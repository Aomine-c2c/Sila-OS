#!/usr/bin/env bash
# KAIROS Virtual Machine Boot Script
# Verifies QEMU hypervisor dependencies, detects hardware virtualization,
# and boots the KAIROS Live ISO in an emulated UEFI/VirtIO machine.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

ISO_PATH="${1:-out/iso/kairos-os-0.1.0-x86_64.iso}"
RAM_MB="${2:-4096}"
CORES="${3:-4}"

echo "================================================================================"
echo " ◈ KAIROS OS Virtual Machine Boot Engine (QEMU)"
echo " ISO Image : ${ISO_PATH}"
echo " Memory    : ${RAM_MB} MB"
echo " CPU Cores : ${CORES}"
echo "================================================================================"

# Step 1: Verify ISO exists
if [[ ! -f "$ISO_PATH" ]]; then
    echo "[!] Error: Target ISO '${ISO_PATH}' does not exist. Run './scripts/build-iso' first." >&2
    exit 1
fi

# Step 2: Check QEMU dependency
if ! command -v qemu-system-x86_64 >/dev/null 2>&1; then
    echo "[*] Notice: 'qemu-system-x86_64' is not installed in the current environment."
    echo "[*] To run the VM on a host with QEMU, execute:"
    echo "    qemu-system-x86_64 -m ${RAM_MB} -smp ${CORES} -cdrom ${ISO_PATH} -boot d -vga virtio -net nic,model=virtio -net user"
    exit 0
fi

# Step 3: Hardware acceleration flags
KVM_FLAG=""
if [[ -w "/dev/kvm" ]] 2>/dev/null; then
    echo "[+] KVM acceleration enabled."
    KVM_FLAG="-enable-kvm -cpu host"
else
    echo "[*] KVM device not accessible. Running in software TCG mode."
    KVM_FLAG="-cpu max"
fi

echo "[+] Spawning QEMU virtual machine..."
qemu-system-x86_64 \
    $KVM_FLAG \
    -m "${RAM_MB}" \
    -smp "${CORES}" \
    -cdrom "${ISO_PATH}" \
    -boot d \
    -vga virtio \
    -net nic,model=virtio \
    -net user \
    -serial mon:stdio
