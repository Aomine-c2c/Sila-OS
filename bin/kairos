def system_info():
    os_rel = get_os_release()
    total_mem, used_mem, free_mem, avail_mem = get_memory()
    cpu_model, cpu_cores = get_cpu_info()
    storage = get_storage_info()
    net = get_network_state()
    boot_mode, boot_cmdline = get_boot_mode()

    print("================================================================================")
    print(" ◈ KAIROS OS - System Diagnostic & Identity Report")
    print(" Identity: KAIROS Adaptive Trading Operating System")
    print("================================================================================")
    print(f" [Operating System] : {os_rel.get('PRETTY_NAME', 'KAIROS Linux')}")
    print(f" [OS ID / Codename] : {os_rel.get('ID', 'kairos')} ({os_rel.get('VERSION_CODENAME', 'aethelgard')})")
    print(f" [OS Version]       : {os_rel.get('VERSION_ID', '0.1.0-minimal')}")
    print(f" [Kernel Release]   : {platform.release()}")
    print(f" [Architecture]     : {platform.machine()}")
    print(f" [Hostname]         : {socket.gethostname()}")
    print(f" [System Uptime]    : {get_uptime()}")
    print("--------------------------------------------------------------------------------")
    print(f" [CPU Model]        : {cpu_model}")
    print(f" [CPU Cores]        : {cpu_cores} logical core(s)")
    print(f" [Memory Total]     : {format_bytes(total_mem)} (Used: {format_bytes(used_mem)} | Avail: {format_bytes(avail_mem)})")
    print("--------------------------------------------------------------------------------")
    print(" [Root Filesystem]  :")
    for s in storage:
        print(f"   {s}")
    print("--------------------------------------------------------------------------------")
    print(f" [Network State]    : {', '.join(net.keys()) if net else 'Loopback Only'}")
    print(f" [Boot Mode]        : {boot_mode}")
    print(f" [Kernel Cmdline]   : {boot_cmdline}")
    print("================================================================================")
    print(" System Initialization: PASS | Status: STABLE")
    print("================================================================================")
    return 0

# --- NETWORKING SUBSYSTEM ---

def network_status_command():
    netmon_script = "/usr/local/bin/kairos-netmon"
    if not os.path.exists(netmon_script):
        netmon_script = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))), "scripts/network/kairos_netmon.py")
    if os.path.exists(netmon_script):
        return subprocess.call([sys.executable, netmon_script, "status"])
    else:
        # Inline fallback
        net = get_network_state()
        print("================================================================================")
        print(" ◈ KAIROS OS - Network Stack & Quality Diagnostic")
        print("================================================================================")
        print(f" [Active Interfaces]  : {', '.join(net.keys()) if net else 'None'}")
        print(" [Network State]      : OPERATIONAL")
        print("================================================================================")
        return 0

def network_interfaces_command():
    netmon_script = "/usr/local/bin/kairos-netmon"
    if not os.path.exists(netmon_script):
        netmon_script = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))), "scripts/network/kairos_netmon.py")
    if os.path.exists(netmon_script):
        return subprocess.call([sys.executable, netmon_script, "interfaces"])
    else:
        try:
            return subprocess.call(["ip", "addr"])
        except Exception:
            return 0

def network_diagnostics_command():
