    return 0

def logs_command(subargs):
    as_json = "--json" in subargs
    srv = ""
    lines = 20
    for i, a in enumerate(subargs):
        if a in ("--service", "-s") and i + 1 < len(subargs):
            srv = subargs[i + 1]
        elif a in ("--lines", "-n") and i + 1 < len(subargs):
            try:
                lines = int(subargs[i + 1])
            except Exception:
                pass

    client_request = get_sysd_client()
    if client_request:
        res = client_request("observability.logs", {"service": srv, "lines": lines})
    else:
        res = {
            "logs": [
                {"timestamp": time.strftime("%H:%M:%S"), "service": "kairos-riskd", "level": "INFO", "message": "Pre-trade risk invariant verification nominal"},
                {"timestamp": time.strftime("%H:%M:%S"), "service": "kairos-feedd", "level": "INFO", "message": "Feed ingestion active: 14,200 ticks/sec"}
            ],
            "sanitized": True
        }

    if as_json:
        print(json.dumps(res, indent=2))
        return 0

    print("================================================================================")
    print(f" ◈ KAIROS Secure Service Logs (Secret-Scrubbed Guaranteed | Filter: {srv or 'ALL'})")
    print(" Invariant: Logs never contain API keys, credentials, or private keys.")
    print("================================================================================")
    for entry in res.get("logs", []):
        lvl_col = "\033[32m" if entry.get("level") == "INFO" else ("\033[33m" if entry.get("level") == "WARN" else "\033[31m")
        print(f" [{entry.get('timestamp')}] {lvl_col}[{entry.get('level')}]{'\033[0m'} ({entry.get('service')}) {entry.get('message')}")
    print("================================================================================")
    return 0

def events_command(subargs):
    as_json = "--json" in subargs
    limit = 25
    for i, a in enumerate(subargs):
        if a in ("--lines", "-n", "--limit") and i + 1 < len(subargs):
            try:
                limit = int(subargs[i + 1])
            except Exception:
                pass

    client_request = get_sysd_client()
    if client_request:
        res = client_request("observability.events", {"limit": limit})
    else:
        try:
            from system.observability.collector import get_observability_collector
            res = {"events": get_observability_collector().query_recent_events(limit=limit)}
        except Exception as e:
            print(f"Error querying events: {e}")
            return 1

    if as_json:
        print(json.dumps(res, indent=2))
        return 0

    print("================================================================================")
    print(" ◈ KAIROS Real-Time Operational Event Timeline")
    print(" Coverage: Trading | Risk | AEI | Kernel | Network | Brokers | Audit")
    print("================================================================================")
    for ev in res.get("events", []):
        print(f" [{ev.get('timestamp')}] \033[36m[{ev.get('domain'):<7}]\033[0m ({ev.get('level')}) {ev.get('message')}")
    print("================================================================================")
    return 0

def recovery_command(subargs):
    """KAIROS Recovery Environment and Disaster Recovery Manager."""
    from system.recovery.engine import get_recovery_engine
    eng = get_recovery_engine()

    action = "status"
    if subargs and not subargs[0].startswith("-"):
        action = subargs[0]
        subargs = subargs[1:]

    as_json = "--json" in subargs

    if action in ("menu", "interactive"):
        import subprocess
        rec_bin = shutil.which("kairos-recovery") or os.path.join(os.path.dirname(os.path.abspath(__file__)), "kairos-recovery")
        if os.path.exists(rec_bin):
            return subprocess.run([rec_bin, "menu"]).returncode
        else:
            print(f"Error: kairos-recovery executable not found at {rec_bin}")
            return 1

    if action in ("boot-repair", "repair-boot"):
        res = eng.repair_bootloader()
        if as_json:
            print(json.dumps(res, indent=2))
        else:
            print("================================================================================")
            print(" ◈ KAIROS Bootloader & Kernel Repair")
            print("================================================================================")
            for item in res.get("repaired_items", []):
                print(f" [✓] {item}")
            print(f" ESP Partition : {res.get('efi_system_partition')}")
            print(f" Kernel Image  : {'Verified' if res.get('kernel_image_verified') else 'Staged / Missing'}")
            print(f" Initramfs     : {'Verified' if res.get('initramfs_verified') else 'Staged / Missing'}")
            print(f" Status        : {res.get('status')}")
            print("================================================================================")
        return 0

    elif action in ("fs-check", "fs-diag", "filesystem"):
        res = eng.check_filesystem()
        if as_json:
            print(json.dumps(res, indent=2))
        else:
            print("================================================================================")
            print(" ◈ KAIROS Filesystem & Subvolume Diagnostics")
            print("================================================================================")
            print(f" Root Filesystem : {res.get('root_filesystem')} (Read-Only: {res.get('read_only_root')})")
            print(f" Scrub Status    : {res.get('scrub_status')}")
            print(f" Space Usage     : {res.get('space_usage', {}).get('used_gb')}GB used / {res.get('space_usage', {}).get('total_gb')}GB total ({res.get('space_usage', {}).get('use_pct')}%)")
            for sv, data in res.get("subvolumes", {}).items():
                print(f"   * Subvolume {sv:<12} Mount: {data.get('mount'):<12} Mode: {data.get('mode'):<4} Status: {data.get('status')}")
            print("================================================================================")
        return 0

    elif action in ("rollback", "rollback-update"):
        target_snap = None
        for i, a in enumerate(subargs):
            if not a.startswith("-"):
                target_snap = a
                break
        res = eng.rollback_update(target_snap)
        if as_json:
            print(json.dumps(res, indent=2))
        else:
            print("================================================================================")
            print(" ◈ KAIROS Atomic Update Rollback")
            print("================================================================================")
            print(f" [✓] {res.get('message')}")
            print(f" Target Snapshot : {res.get('target_snapshot')}")
            print(f" Next Boot       : {res.get('next_boot_subvolume')}")
            print("================================================================================")
        return 0

    elif action in ("service-repair", "repair-services"):
        srv = None
        if subargs and not subargs[0].startswith("-"):
            srv = subargs[0]
        res = eng.repair_services(srv)
        if as_json:
            print(json.dumps(res, indent=2))
        else:
            print("================================================================================")
            print(" ◈ KAIROS Service Repair & State Reset")
            print("================================================================================")
            for r in res.get("repaired_services", []):
                print(f" [✓] {r['service']} -> {r['action']} ({r['result']})")
            print(f" Stale Locks Cleared : {len(res.get('stale_sockets_cleared', []))}")
            print(f" Status              : {res.get('status')}")
            print("================================================================================")
        return 0

    elif action in ("user-repair", "user-recovery"):
        username = "trader"
        if subargs and not subargs[0].startswith("-"):
            username = subargs[0]
        res = eng.recover_user(username, "reconcile")
        if as_json:
            print(json.dumps(res, indent=2))
        else:
            print("================================================================================")
            print(f" ◈ KAIROS User Recovery: {username}")
            print("================================================================================")
            print(f" [✓] {res.get('message')}")
            print(f" Account Status : {res.get('account_status')}")
            print(f" Sudoers Policy : {res.get('sudoers_status')}")
            print("================================================================================")
        return 0

    elif action in ("restore", "system-restore"):
        res = eng.system_restore("factory_reset_preserve_data")
        if as_json:
            print(json.dumps(res, indent=2))
        else:
            print("================================================================================")
            print(" ◈ KAIROS System Restore")
            print("================================================================================")
            print(f" [✓] {res.get('message')}")
            print(f" Preserved Paths : {', '.join(res.get('preserved_paths', []))}")
            print(f" Reset Scopes    : {', '.join(res.get('reset_components', []))}")
            print("================================================================================")
        return 0

    elif action in ("status", "info"):
        fs = eng.check_filesystem()
        snapshots = eng.list_snapshots()
        stat = {
            "recovery_environment": "READY",
            "active_mode": "normal",
            "filesystem_status": fs.get("status"),
            "snapshots_available": len(snapshots),
            "emergency_shell_available": True
        }
        if as_json:
            print(json.dumps(stat, indent=2))
        else:
            print("================================================================================")
            print(" ◈ KAIROS Recovery Subsystem - Status: READY")
            print("================================================================================")
            print(f" [Recovery Status]   : READY (Disaster failover & rescue engine)")
            print(f" [Emergency Shell]   : Available (/bin/sh on tty1/console)")
            print(f" [Filesystem State]  : {fs.get('status')}")
            print(f" [Snapshots Staged]  : {len(snapshots)} generation(s) available for rollback")
            print("================================================================================")
        return 0
    else:
        print(f"Unknown recovery action: '{action}'. Available: menu, boot-repair, fs-check, rollback, service-repair, user-repair, restore, status")
        return 1

def main():
    args = sys.argv[1:]
    if len(args) >= 1 and args[0] in ("recovery", "rescue"):
        return recovery_command(args[1:])
    elif len(args) >= 1 and args[0] == "status":
        return status_command(args[1:])
    elif len(args) >= 1 and args[0] in ("health", "check-health"):
        return health_command(args[1:])
    elif len(args) >= 1 and args[0] in ("diagnostics", "diag"):
        return diagnostics_command(args[1:])
    elif len(args) >= 1 and args[0] in ("logs", "log"):
        return logs_command(args[1:])
    elif len(args) >= 1 and args[0] in ("events", "event", "timeline"):
        return events_command(args[1:])
    elif len(args) >= 1 and args[0] in ("adaptive", "aei"):
        return adaptive_command(args[1:])
    elif len(args) >= 1 and args[0] in ("agent", "agents", "ai"):
        return agent_command(args[1:])
    elif len(args) >= 1 and args[0] in ("plugin", "plugins"):
        return plugin_command(args[1:])
    elif len(args) >= 1 and args[0] in ("research", "researchd", "backtest"):
        return research_command(args[1:])
    elif len(args) >= 1 and args[0] in ("risk", "riskd"):
        return risk_command(args[1:])
    elif len(args) >= 1 and args[0] in ("trade", "trading"):
        return trading_command(args[1:])
    elif len(args) >= 1 and args[0] in ("sandbox", "isolation", "isolate"):
        return sandbox_command(args[1:])
    elif len(args) >= 1 and args[0] in ("pkg", "package", "packages"):
        return package_command(args[1:])
    elif len(args) >= 1 and args[0] in ("service", "services"):
        return service_command(args[1:])
    elif len(args) >= 1 and args[0] in ("app", "apps"):
        return app_command(args[1:])
    elif len(args) >= 1 and args[0] in ("theme", "ui-theme"):
        return theme_command(args[1:])
    elif len(args) >= 1 and args[0] in ("cmd", "palette"):
        return cmd_palette_command(args[1:])
    elif len(args) >= 1 and args[0] == "shell":
        return shell_command(args[1:])
    elif len(args) >= 2 and args[0] == "gpu" and args[1] == "info":
        return graphics_command("gpu")
    elif len(args) >= 2 and args[0] == "display" and args[1] == "info":
        return graphics_command("display")
    elif len(args) >= 2 and args[0] == "input" and args[1] == "info":
        return graphics_command("input")
    elif len(args) == 1 and args[0] == "gpu":
        return graphics_command("gpu")
    elif len(args) == 1 and args[0] == "display":
        return graphics_command("display")
    elif len(args) == 1 and args[0] == "input":
        return graphics_command("input")
    elif len(args) >= 2 and args[0] == "network" and args[1] == "status":
        return network_status_command()
    elif len(args) >= 2 and args[0] == "network" and args[1] in ("interfaces", "ifaces", "if"):
        return network_interfaces_command()
    elif len(args) >= 2 and args[0] == "network" and args[1] in ("diagnostics", "diag", "check"):
        return network_diagnostics_command()
    elif len(args) == 1 and args[0] == "network":
        return network_status_command()
    elif len(args) >= 2 and args[0] == "user" and args[1] == "info":
        return user_info_command()
    elif len(args) == 1 and args[0] in ("permissions", "perm"):
        return permissions_command()
    elif len(args) >= 2 and args[0] == "storage" and args[1] == "info":
        return storage_info()
    elif len(args) >= 2 and args[0] == "storage" and args[1] in ("check", "health"):
        return storage_info()
    elif len(args) == 1 and args[0] == "storage":
        return storage_info()
    elif len(args) >= 2 and args[0] == "boot" and args[1] in ("diag", "diagnostics"):
        return boot_diagnostics()
    elif len(args) >= 2 and args[0] == "boot" and args[1] == "status":
        mode, cmdline = get_boot_mode()
        print(f"Boot Mode: {mode}")
        print(f"Command Line: {cmdline}")
        return 0
    elif len(args) >= 2 and args[0] == "system" and args[1] == "info":
        return system_info()
    elif len(args) == 1 and args[0] == "system":
        return system_info()
    elif len(args) == 1 and args[0] == "boot":
        return boot_diagnostics()
    elif len(args) == 1 and args[0] == "user":
        return user_info_command()
    elif len(args) == 0:
        print("KAIROS Control CLI")
        print("Usage:")
        print("  kairos status              - Centralized system & trading status (dense overview)")
        print("  kairos health              - Multi-domain health matrix across all 12 subsystems")
        print("  kairos diagnostics         - Deep latency, kernel, memory, and invariant diagnostics")
        print("  kairos logs                - Structured, secret-scrubbed service & system logs")
        print("  kairos events              - Real-time operational event timeline across all domains")
        print("  kairos recovery <action>   - Disaster recovery & rescue manager (menu|boot-repair|fs-check|rollback|service-repair|user-repair|restore|status)")
        print("  kairos adaptive <action>   - Adaptive Evolution Intelligence (status|cycle|wheel|history|memory|rollback|verify-security)")
        print("  kairos agent <action>      - Autonomous AI agent platform (list|info|propose|audit|sanitize)")
        print("  kairos plugin <action>     - Capability-based plugin platform (list|search|install|remove|enable|disable|info)")
        print("  kairos research <action>   - Quantitative research environment & backtest registry (status|datasets|experiments|run|credentials-check)")
        print("  kairos risk <action>       - Central safety boundary & pre-trade risk engine (status|halt|resume|close-only|pause|unpause)")
        print("  kairos trade <action>      - Trading subsystem engine (status|tick|strategies|strategy|journal)")
        print("  kairos sandbox <action>    - Security isolation manager (profiles|check|generate)")
        print("  kairos package <action>    - Software layer manager (search|install|remove|update|info|list)")
        print("  kairos service <action>    - Service lifecycle manager (list|status|start|stop|restart|logs)")
        print("  kairos app <app>           - Launch/inspect core system application (14 apps)")
        print("  kairos theme [get|set]     - System design system theme switcher")
        print("  kairos system info         - System diagnostic & identity report")
        print("  kairos boot diag           - Boot subsystem diagnostics")
        print("  kairos boot status         - Boot mode & command line status")
        print("  kairos storage info        - Storage architecture & disk telemetry")
        print("  kairos storage health      - SMART drive telemetry & health check")
        print("  kairos user info           - User identity & capability report")
        print("  kairos permissions         - Permission boundaries & service sandboxes")
        print("  kairos network status      - Network stack health & gateway audit")
        print("  kairos network interfaces  - Detailed interface inventory")
        print("  kairos network diagnostics - Live quality, latency, & DNS benchmark")
        print("  kairos gpu info            - GPU hardware detection & DRM acceleration")
        print("  kairos display info        - Wayland display protocol & monitor scaling")
        print("  kairos input info          - Input devices & libinput latency state")
        print("  kairos shell state         - Desktop shell IPC telemetry state")
        print("  kairos cmd <command>       - Execute typed KAIROS command")
        return 0
    else:
        return system_info()

if __name__ == "__main__":
    sys.exit(main())

