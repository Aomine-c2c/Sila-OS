def get_sysd_client():
    sysd_paths = [
        "/usr/libexec/kairos/kairos_sysd.py",
        os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts/services/kairos_sysd.py"),
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "../scripts/services/kairos_sysd.py")
    ]
    for p in sysd_paths:
        if os.path.exists(p):
            import importlib.util
            spec = importlib.util.spec_from_file_location("kairos_sysd", p)
            if spec and spec.loader:
                sysd_module = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(sysd_module)
                return sysd_module.client_request
    return None

def status_command(subargs):
    as_json = "--json" in subargs
    client_request = get_sysd_client()
    if client_request:
        res = client_request("observability.status")
    else:
        try:
            from system.observability.collector import get_observability_collector
            res = get_observability_collector().get_full_status_snapshot()
        except Exception as e:
            print(f"Error gathering status: {e}")
            return 1

    if as_json:
        print(json.dumps(res, indent=2))
        return 0

    print("================================================================================")
    print(" ◈ KAIROS Operating System - Centralized System & Trading Status")
    print(f" Timestamp: {res.get('timestamp_utc')} | Architecture: {res.get('os', {}).get('architecture')}")
    print("================================================================================")
    
    # OS & Kernel
    os_info = res.get("os", {})
    kern = res.get("kernel", {})
    print(f" [OS & KERNEL]      : {os_info.get('os_name')} v{os_info.get('version')} ({os_info.get('edition')})")
    print(f"   Kernel Substrate : {kern.get('flavor')} ({kern.get('preemption')})")
    print(f"   Load Averages    : {os_info.get('load_averages')} | Uptime: {os_info.get('uptime')}")
    print(f"   RT Jitter (p99)  : {kern.get('timer_jitter_p99_us')}us | Busy Poll: {kern.get('busy_poll_us')}us")
    print("-" * 80)

    # Trading & Risk Subsystem
    trade = res.get("trading", {})
    risk = res.get("risk", {})
    exec_d = res.get("execution", {})
    print(f" [TRADING ENGINE]   : Mode: \033[32m{trade.get('mode')}\033[0m | Feed: {trade.get('ticks_ingested_sec')} ticks/sec")
    print(f"   Tracked Symbols  : {', '.join(trade.get('symbols_tracked', []))}")
    print(f"   Risk Boundary    : \033[32m{risk.get('gatekeeper_state')}\033[0m (Drawdown: {risk.get('current_drawdown_pct')}% / Max: {risk.get('max_drawdown_limit_pct')}%)")
    print(f"   Execution Engine : {exec_d.get('engine')} | Latency: {exec_d.get('average_fill_latency_ms')}ms | Slippage: {exec_d.get('realized_slippage_bps')} bps")
    print("-" * 80)

    # Brokers & Network
    net = res.get("network", {})
    brokers = res.get("brokers", {})
    print(f" [BROKERS & NETWORK]: Network: \033[32m{net.get('status')}\033[0m ({net.get('interface')}) | Gateway RTT: {net.get('gateway_rtt_avg_ms')}ms")
    print(f"   Packet Loss/Drops: Loss: {net.get('packet_loss_pct')}% | NIC Drops: {net.get('nic_ringbuffer_drops')}")
    for bg in brokers.get("gateways", []):
        st_color = "\033[32m" if bg.get("state") == "CONNECTED" else "\033[34m"
        print(f"   - Gateway        : {bg.get('name'):<32} State: {st_color}{bg.get('state'):<10}\033[0m RTT: {bg.get('latency_ms')}ms")
    print("-" * 80)

    # Adaptive Wheel & AI Agents
    agents_aei = res.get("agents_aei", {})
    wheel = agents_aei.get("aei_wheel", {})
    ai = agents_aei.get("ai_agents", {})
    print(f" [ADAPTIVE & AI]    : AEI Wheel State: \033[35m{wheel.get('state')}\033[0m (Sector: {wheel.get('sector')} @ {wheel.get('current_angle_deg')}°)")
    print(f"   Autonomous Agents: {', '.join(ai.get('active', []))} | Tier: {ai.get('permission_tier')}")
    print("-" * 80)

    # Managed Services Summary
    services = res.get("services", [])
    print(f" [MANAGED SERVICES] : {len(services)} Active Services Registered")
    for s in services[:6]:
        col = "\033[32m" if s.get("health") == "HEALTHY" else "\033[31m"
        print(f"   - {s.get('name'):<22} Health: {col}{s.get('health'):<8}\033[0m Uptime: {s.get('uptime'):<10} Res: {s.get('resource_usage')}")
    if len(services) > 6:
        print(f"   ... and {len(services) - 6} additional services. Run 'kairos health' or 'kairos service list' for full roster.")
    print("================================================================================")
    return 0

def health_command(subargs):
    as_json = "--json" in subargs
    client_request = get_sysd_client()
    if client_request:
        res = client_request("observability.health")
    else:
        try:
            from system.observability.collector import get_observability_collector
            res = get_observability_collector().get_health_verdict()
        except Exception as e:
            print(f"Error gathering health: {e}")
            return 1

    if as_json:
        print(json.dumps(res, indent=2))
        return 0

    ov = res.get("overall_health", "UNKNOWN")
    col_ov = "\033[32m" if ov == "HEALTHY" else "\033[31m"
    print("================================================================================")
    print(f" ◈ KAIROS System Health Matrix - Status: {col_ov}{ov}\033[0m")
    print(f" Monitored Domains: {res.get('monitored_domains_count')} | Verified at UTC: {res.get('timestamp_utc')}")
    print("================================================================================")
    print(f" {'DOMAIN':<18} {'STATUS':<12} {'DETAILS'}")
    print("-" * 80)
    for domain, status in res.get("domains", {}).items():
        col = "\033[32m" if status == "HEALTHY" else "\033[31m"
        detail = "Nominal operation & zero invariant breaches" if status == "HEALTHY" else "Degraded performance"
        print(f" {domain.upper():<18} {col}{status:<12}\033[0m {detail}")
    print("-" * 80)
    unhealthy = res.get("unhealthy_services", [])
    if unhealthy:
        print(f" \033[31m[!] Degraded Services: {', '.join(unhealthy)}\033[0m")
    else:
        print(" \033[32m[✓] All 12 critical subsystems operating within guaranteed SLAs.\033[0m")
    print("================================================================================")
    return 0

