    if not os.path.exists(netmon_script):
        netmon_script = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))), "scripts/network/kairos_netmon.py")
    if os.path.exists(netmon_script):
        return subprocess.call([sys.executable, netmon_script, "diag"])
    else:
        print("[+] Network diagnostic inline check: NOMINAL")
        return 0

def graphics_command(action):
    # Locate kairos_graphics.py in local scripts, KAIROS_ROOTFS, or standard system paths
    script_paths = []
    if ROOT_PREFIX:
        script_paths.extend([
            os.path.join(ROOT_PREFIX, "usr/libexec/kairos/kairos_graphics.py"),
            os.path.join(ROOT_PREFIX, "usr/local/bin/kairos_graphics.py")
        ])
    script_paths.extend([
        "/usr/libexec/kairos/kairos_graphics.py",
        "/usr/local/bin/kairos_graphics.py",
        os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts/hardware/kairos_graphics.py"),
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "../scripts/hardware/kairos_graphics.py"),
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "scripts/hardware/kairos_graphics.py")
    ])
    found = None
    for p in script_paths:
        if os.path.exists(p):
            found = p
            break

    if found:
        return subprocess.call([sys.executable, found, action])
    else:
        # Fallback inline execution
        try:
            from scripts.hardware import kairos_graphics
            if action == "gpu":
                return kairos_graphics.print_gpu_info()
            elif action == "display":
                return kairos_graphics.print_display_info()
            elif action == "input":
                return kairos_graphics.print_input_info()
        except Exception as e:
            print(f"Error invoking graphics engine ({action}): {e}")
            return 1
    return 0

def shell_command(subargs):
    script_paths = []
    if ROOT_PREFIX:
        script_paths.append(os.path.join(ROOT_PREFIX, "usr/libexec/kairos/kairos_shell_state.py"))
    script_paths.extend([
        "/usr/libexec/kairos/kairos_shell_state.py",
        "/usr/local/bin/kairos_shell_state.py",
        os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts/shell/kairos_shell_state.py"),
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "../scripts/shell/kairos_shell_state.py")
    ])
    for p in script_paths:
        if os.path.exists(p):
            return subprocess.call([sys.executable, p] + subargs)
    print("KAIROS shell state engine not found.")
    return 1

def cmd_palette_command(subargs):
    script_paths = []
    if ROOT_PREFIX:
        script_paths.append(os.path.join(ROOT_PREFIX, "usr/libexec/kairos/kairos_cmd.py"))
    script_paths.extend([
        "/usr/libexec/kairos/kairos_cmd.py",
        "/usr/local/bin/kairos_cmd.py",
        os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts/shell/kairos_cmd.py"),
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "../scripts/shell/kairos_cmd.py")
    ])
    for p in script_paths:
        if os.path.exists(p):
            return subprocess.call([sys.executable, p] + subargs)
def theme_command(subargs):
    script_paths = []
    if ROOT_PREFIX:
        script_paths.append(os.path.join(ROOT_PREFIX, "usr/libexec/kairos/kairos_theme.py"))
    script_paths.extend([
        "/usr/libexec/kairos/kairos_theme.py",
        "/usr/local/bin/kairos_theme.py",
        os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts/shell/kairos_theme.py"),
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "../scripts/shell/kairos_theme.py")
    ])
    for p in script_paths:
        if os.path.exists(p):
            return subprocess.call([sys.executable, p] + subargs)
    print("KAIROS theme engine not found.")
    return 1

def app_command(subargs):
