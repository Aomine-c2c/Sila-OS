[Unit]
Description=KAIROS AI Agent Advisory & Strategy Reasoning Service
Documentation=file:///usr/share/doc/kairos/service-architecture.md
After=kairos-riskd.service kairos-sysd.service
PartOf=kairos-ai.target

[Service]
Type=simple
User=kairos-agent
Group=plugins
ExecStart=/usr/bin/python3 /usr/libexec/kairos/kairos-agentd.py
Restart=always
RestartSec=3s
# Resource Limits & Isolation: AI processes clamped, no raw sockets, zero root escalation
MemoryMax=2G
CPUQuota=150%
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
