[Unit]
Description=KAIROS System Latency & Hardware Watchdog Daemon
Documentation=https://kairos-os.org/docs/watchdog
After=multi-user.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /usr/libexec/kairos/kairos-watchdog.py
Restart=always
RestartSec=2
CPUSchedulingPolicy=rr
CPUSchedulingPriority=50

[Install]
WantedBy=multi-user.target
