[Unit]
Description=KAIROS Privileged System Daemon & Protected OS Boundary
Documentation=man:kairos(1) file:///usr/share/doc/kairos/core-applications.md
DefaultDependencies=no
After=local-fs.target systemd-sysctl.service
Before=multi-user.target graphical.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
ExecStart=/usr/libexec/kairos/kairos_sysd.py --daemon
Restart=always
RestartSec=1s
StandardOutput=journal
StandardError=journal
# Hardened sandboxing for root service
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/kairos /var/log/audit
RuntimeDirectory=kairos
RuntimeDirectoryMode=0755
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_AUDIT_WRITE CAP_DAC_OVERRIDE
NoNewPrivileges=no
KillMode=process
TasksMax=256

[Install]
WantedBy=multi-user.target
