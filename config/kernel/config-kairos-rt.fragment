# KAIROS Low-Latency & Real-Time Kernel Configuration Fragments
# Tailored for sub-millisecond execution, market packet processing, and isolation

# Preemption Model: Fully Preemptible Kernel (Real-Time)
CONFIG_PREEMPT_RT=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_COUNT=y

# High Resolution Timers & Tickless OS
CONFIG_NO_HZ_FULL=y
CONFIG_NO_HZ=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# CPU Frequency & Governor Tuning: Performance Priority
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y

# Memory Management & Low-Latency Allocators
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_SLUB=y
CONFIG_MEMCG=y

# Security Hardening & Isolation
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_SELINUX=n
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_PAGE_TABLE_ISOLATION=y

# Hardware & High Performance Network Stack
CONFIG_NET_RX_BUSY_POLL=y
CONFIG_XDP_SOCKETS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_NET_CLS_ACT=y
CONFIG_WIREGUARD=y
CONFIG_BTRFS_FS=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_CHACHA20_X86_64=y
CONFIG_CRYPTO_POLY1305_X86_64=y
