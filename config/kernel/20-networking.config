# 20-networking.config: Ethernet, Wi-Fi, WireGuard, eBPF
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y

# Wired Ethernet Drivers (Intel, Realtek, Broadcom, Aquantia)
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IXGBE=m
CONFIG_I40E=m
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=m

# Wireless Drivers (Intel, Realtek, Qualcomm Atheros)
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLMVM=m
CONFIG_IWLDVM=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW89=m

# Modern Networking & Security
CONFIG_WIREGUARD=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_NET_CLS_ACT=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
