# 70-virtualization.config: KVM Hypervisor & VirtIO Guest Drivers
CONFIG_HAVE_KVM=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m

# VirtIO Drivers for Guest Performance
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y

# Hyper-V and VMware Guest Paravirtualization
CONFIG_HYPERV=y
CONFIG_VMWARE_VMCI=m
CONFIG_XEN=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
